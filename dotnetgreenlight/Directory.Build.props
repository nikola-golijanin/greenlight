<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515 (make types internal) conflicts with WebApplicationFactory<Program>/vertical-slice public types -->
    <!-- CA1848/CA1873 (LoggerMessage delegates) are noise for an app this size -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA1711;CA1062;CA2007</NoWarn>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
