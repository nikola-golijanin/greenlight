{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "RequestTimeout": "00:00:03",
    "Cors": {
      "TrustedOrigins": []
    },
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 10,
      "Window": "00:00:05"
    }
  }
}
