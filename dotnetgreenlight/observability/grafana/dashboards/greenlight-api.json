{
  "uid": "greenlight-api",
  "title": "Greenlight API",
  "tags": [
    "greenlight",
    "dotnet",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": {
          "qryType": 1,
          "query": "label_values(target_info{job=\"greenlight-api\"}, deployment_environment_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(target_info{job=\"greenlight-api\"}, deployment_environment_name)",
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": {
          "qryType": 1,
          "query": "label_values(target_info{job=\"greenlight-api\", deployment_environment_name=~\"$env\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(target_info{job=\"greenlight-api\", deployment_environment_name=~\"$env\"}, instance)",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
