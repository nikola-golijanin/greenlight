{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local env",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api",
            "args": [
                "--port=4000",
                "--env=development",
                "--db-dsn=postgres://postgres:a-secure-password@localhost/greenlight?sslmode=disable",
                "--db-max-open-conns=50",
                "--db-max-idle-time=2h30m",
                "--limiter-requests=2",
                "--limiter-window=5s",
                "--limiter-enabled=false"
            ],
        },
        {
            "name": "Homelab env",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api",
            "args": [
                "--port=4000",
                "--env=development",
                "--db-dsn=postgres://postgres:postgres@192.168.1.60/greenlight?sslmode=disable",
                "--db-max-open-conns=50",
                "--db-max-idle-time=2h30m",
                "--limiter-requests=2",
                "--limiter-window=5s",
                "--limiter-enabled=false"
            ],
        }
    ]
}
